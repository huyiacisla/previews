{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["src/**/*.js", "tests/**/*.mjs", "vite.config.ts", "!**/dist"] },
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": { "noInnerDeclarations": "warn" },
			"complexity": { "useOptionalChain": "off", "noArguments": "warn" },
			"style": { "useTemplate": "off" },
			"suspicious": { "useIterableCallbackReturn": "off", "noAssignInExpressions": "off", "noTemplateCurlyInString": "off" }
		}
	}
}
